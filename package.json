{
  "name": "astro-paper",
  "version": "2.2.0",
  "private": false,
  "scripts": {
    "dev": "astro check --watch & astro dev",
    "start": "astro dev",
    "build": "astro build && jampack ./dist --exclude 'ohm/**'",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "cz": "cz",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.7",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@divriots/jampack": "^0.34.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "!(*.{png,jpg,jpeg,webp})": [
      "prettier --write --ignore-unknown"
    ]
  },
  "overrides": {
    "@divriots/jampack": {
      "sharp": "^0.35.5",
      "esbuild": "^0.28.2",
      "file-type": "^21.3.1",
      "undici": "^6.29.1"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "fflate": "^0.7.5",
    "minimatch@^10": "^11.0.5",
    "@divriots/cheerio": {
      "undici": "^6.29.1"
    }
  }
}
