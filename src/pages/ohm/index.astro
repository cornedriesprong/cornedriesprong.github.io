---
import Layout from "@layouts/Layout.astro";
import Footer from "@components/Footer.astro";
import socialIcons from "@assets/socialIcons";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";

// the docs are the ohm README, fetched and rendered when the site is built
const README_URL =
  "https://raw.githubusercontent.com/cornedriesprong/ohm/main/README.md";
const response = await fetch(README_URL);
if (!response.ok) {
  throw new Error(`could not fetch ${README_URL}: ${response.status}`);
}
const readme = await response.text();

// the hero already has the title and tagline, so of the text above the first
// section only callouts (> [!CAUTION] etc.) are kept
const [intro, ...sections] = readme.split(/^(?=## )/m);
const callouts = intro
  .split(/\n{2,}/)
  .filter(block => block.startsWith("> [!"))
  .map(block =>
    block.replace(
      /^> \[!(\w)(\w*)\]\s*\n> /,
      (_, first, rest) => `> **${first}${rest.toLowerCase()}:** `
    )
  );
const markdown = [...callouts, ...sections].join("\n\n");

const { render } = await createMarkdownProcessor();
const { code: docs } = await render(markdown);

const code = String.raw`bpm = 180

kick = |k n| 
  env = (hit k n) ^ 3
  pm (env * 120) (lfo * 0.15) * env

hat = |k n|
  env = (hit k n) ^ 3 -> lp1 0.5
  noise (lfo * 0.15) * env -> bp 500

mod = lfo * 500 + 500
n1 = <Cm Gm7> -> voice mod
a = n1 * hit 5 8 * 0.5
b = kick 3 8
c = hat 7 16 * 0.2

bus1 = a * 0.4 -> rev
bus2 = a * 0.5 -> bbd 0.5 0.9

{a b c bus1 bus2} -> mix`;

const link =
  "underline decoration-dashed underline-offset-4 hover:text-skin-accent";
---

<Layout pageTitle="ohm">
  <main id="main-content">
    <section id="hero">
      <h1>
        <i>ohm</i>
      </h1>
      <p>
        <b>ohm</b> is a live coding language for music and sound.
      </p>
      <p>
        it's a live coding system consisting of a domain-specific programming
        language and a hot-swapping runtime, so you can hear your changes as you
        type. it is designed to scale all the way from high-level music-making
        (notes, rhythms, chords) down to low-level DSP prototyping.
      </p>
      <br />
      <p>
        <b>example code</b>
      </p>
      <textarea
        id="ohm-src"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        rows={code.split("\n").length + 2}
        aria-label="ohm code editor"
      >{code}</textarea>
      <div class="flex flex-wrap items-center gap-y-2">
        <button id="ohm-play" type="button">
          play
        </button>
        <span class="ml-6 text-sm opacity-70">cmd/ctrl+enter to reload</span>
        <pre id="ohm-log" class="ml-6 text-sm"></pre>
      </div>
      <br />
      <div class="flex flex-wrap items-center gap-y-2 pt-4">
        <a
          href="https://github.com/cornedriesprong/ohm"
          target="_blank"
          title="ohm on GitHub"
          class="group inline-flex items-center gap-1 hover:text-skin-accent"
        >
          <Fragment set:html={socialIcons.Github} />
          <span class={link}>GitHub</span>
        </a>
        <span class="mx-4 opacity-50">|</span>
        <a href="/ohm/slides.html" class={link}>
          slides
        </a>
      </div>
    </section>

    <section id="docs" class="prose max-w-3xl" set:html={docs} />
    <br />
  </main>
  <Footer />

  <script>
    const src = document.getElementById("ohm-src") as HTMLTextAreaElement;
    const play = document.getElementById("ohm-play") as HTMLButtonElement;
    const log = document.getElementById("ohm-log") as HTMLElement;
    let ctx: AudioContext | undefined;
    let node: AudioWorkletNode | undefined;

    const send = () =>
      node?.port.postMessage({
        src: new TextEncoder().encode(src.value),
        fresh: false,
      });

    const fail = (message: string) => {
      log.className = "ml-6 text-sm error";
      log.textContent = message;
    };

    const start = async () => {
      ctx = new AudioContext();
      // the context starts asynchronously, so follow its state for the label
      const label = () =>
        (play.textContent = ctx?.state === "running" ? "stop" : "play");
      ctx.onstatechange = label;
      await ctx.audioWorklet.addModule("/ohm/ohm-worklet.js");
      const module = await WebAssembly.compileStreaming(
        fetch("/ohm/ohm_rs.wasm")
      );
      node = new AudioWorkletNode(ctx, "ohm", {
        outputChannelCount: [2],
        processorOptions: { module },
      });
      node.port.onmessage = ({ data }) => {
        if (data.ok) {
          log.className = "ml-6 text-sm";
          log.textContent = "";
        } else {
          fail(new TextDecoder().decode(data.err));
        }
      };
      node.onprocessorerror = () => fail("engine crashed, reload the page");
      node.connect(ctx.destination);
      send();
      await ctx.resume();
      label();
    };

    play.onclick = async () => {
      try {
        if (!ctx) await start();
        else if (ctx.state === "running") await ctx.suspend();
        else await ctx.resume();
      } catch (e) {
        ctx = undefined;
        fail(String(e));
      }
    };

    src.onkeydown = e => {
      if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
        e.preventDefault();
        send();
      } else if (e.key === "Tab") {
        e.preventDefault();
        src.setRangeText("  ", src.selectionStart, src.selectionEnd, "end");
      }
    };
  </script>

  <style>
    #ohm-src {
      @apply mb-3 mt-6 block w-full rounded-xl border border-skin-line bg-skin-fill p-4 font-mono text-sm text-skin-base;
      resize: vertical;
      white-space: pre-wrap;
      overflow: hidden auto;
      scrollbar-width: none;
      tab-size: 2;
    }
    #ohm-src::-webkit-scrollbar {
      display: none;
    }
    #ohm-src:focus {
      @apply border-skin-accent outline-none;
    }
    #ohm-play {
      @apply rounded-lg border border-skin-line px-5 py-1 font-bold hover:border-skin-accent hover:text-skin-accent;
    }
    #ohm-log {
      @apply m-0 whitespace-pre-wrap;
    }
    #ohm-log.error {
      color: #f66;
    }
    #hero h1 {
      @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
    }
    #hero p {
      @apply my-2;
    }
    #docs {
      @apply pt-8;
    }
    /* the docs are injected html, so these can't be scoped */
    #docs :global(th) {
      vertical-align: middle;
      padding-top: 0.5714286em;
      padding-bottom: 0.5714286em;
    }
    #docs :global(code) {
      @apply whitespace-nowrap;
    }
    /* in light mode, plain (indented / plaintext) code blocks have no syntax
       colors, so they get a light background instead of shiki's always-dark
       inline one (!important to beat the inline style). dark mode keeps
       shiki's dark background. */
    :global(html:not([data-theme="dark"]))
      #docs
      :global(pre:not([data-language])),
    :global(html:not([data-theme="dark"]))
      #docs
      :global(pre[data-language="plaintext"]) {
      @apply !bg-skin-card !bg-opacity-75 !text-skin-base;
    }
    #docs :global(pre code) {
      @apply whitespace-pre p-0;
      background: transparent;
    }
  </style>
</Layout>
